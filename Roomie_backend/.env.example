NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:matkhau@localhost:5432/roomie_dev
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai
JWT_EXPIRES_IN=15m
# Chỉ bật khi dev: cho phép giả lập user bằng header X-Dev-User-Id
AUTH_DEV_BYPASS=true
PUBLIC_BASE_URL=http://localhost:3000
REFRESH_TOKEN_DAYS=30
# Gửi OTP qua Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" (App password).
# Để trống SMTP_HOST khi dev: mã OTP được in ra console của server.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Roomie <no-reply@roomie.app>
# Push FCM: Firebase Console > Project settings > Service accounts > Generate new private key.
# Lưu file vào Roomie_backend/firebase-service-account.json (đã gitignore). Để trống: không gửi push.
FIREBASE_SERVICE_ACCOUNT=
# Đăng nhập Google: Web client ID (Google Cloud Console > APIs & Services > Credentials).
GOOGLE_CLIENT_IDS=
