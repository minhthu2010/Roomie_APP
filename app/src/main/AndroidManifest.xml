<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Roomie">

        <!-- Splash Activity (Launcher) -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Welcome / Main Activity -->
        <activity
            android:name=".ui.auth.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Login Activity -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Register Activity (Step 1) -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Verify Register Activity (Step 2) -->
        <activity
            android:name=".ui.auth.VerifyRegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Profile Setup Activity (Step 3) -->
        <activity
            android:name=".ui.profile.ProfileSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- User Profile Activity (Hồ sơ của tôi) -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Profile Subscreen Activity (Cài đặt & Subscreens) -->
        <activity
            android:name=".ui.profile.ProfileSubscreenActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Poster Profile Activity -->
        <activity
            android:name=".ui.profile.HoSoNguoiDangActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Quiz Intro Activity -->
        <activity
            android:name=".ui.quiz.QuizIntroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Habit Quiz Activity -->
        <activity
            android:name=".ui.quiz.HabitQuizActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Quiz Success Activity (Step 4) -->
        <activity
            android:name=".ui.quiz.QuizSuccessActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Forgot Password Activity -->
        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Verify OTP Activity -->
        <activity
            android:name=".ui.auth.VerifyOtpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Reset Password Activity -->
        <activity
            android:name=".ui.auth.ResetPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Reset Success Activity -->
        <activity
            android:name=".ui.auth.ResetSuccessActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Home Screen / Explore Feed -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Room Detail Activity -->
        <activity
            android:name=".ui.room.ChiTietPhongActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Search Room Activity -->
        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Filter Room Activity -->
        <activity
            android:name=".ui.filter.BoLocActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Saved Rooms Activity -->
        <activity
            android:name=".ui.saved.PhongDaLuuActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- My Posts Activity -->
        <activity
            android:name=".ui.myposts.BaiDangCuaToiActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Create Post Flow Activity -->
        <activity
            android:name=".ui.post.PostFlowActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Matching Results Activity -->
        <activity
            android:name=".ui.matching.KetQuaTuongThichActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Compatibility Detail Activity -->
        <activity
            android:name=".ui.matching.ChiTietTuongThichPhongActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Report Post Activity -->
        <activity
            android:name=".ui.report.BaoCaoBaiDangActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Report Submitted Activity -->
        <activity
            android:name=".ui.report.DaGuiBaoCaoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>