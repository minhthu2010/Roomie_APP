<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomie_primary_badge_dark"
    android:fillViewport="true"
    tools:context=".ui.room.ThuVienAnhPhongActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/color_white" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@id/btn_back"
                android:text="Ảnh phòng"
                android:textColor="@color/color_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_page_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="1 / 8"
                android:textColor="@color/color_white"
                android:textSize="14sp" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="42dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/room_detail_title"
                android:textColor="@color/color_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="268 Lý Thường Kiệt, Quận 10 · Ngọc Anh"
                android:textColor="@color/color_text_pink"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="310dp">

            <ImageView
                android:id="@+id/img_main_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/btn_view_all_photos"
                android:scaleType="centerCrop"
                android:src="@drawable/img_detail_room" />

            <ImageButton
                android:id="@+id/btn_prev_photo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="@color/roomie_primary_badge"
                android:contentDescription="Ảnh trước"
                android:padding="10dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/color_white" />

            <ImageButton
                android:id="@+id/btn_next_photo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="@color/roomie_primary_badge"
                android:contentDescription="Ảnh tiếp theo"
                android:padding="10dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/color_white" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_photo_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:gravity="center"
            android:text="Không gian phòng · Ảnh 1 trong 8"
            android:textColor="@color/color_white"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/thumb1"
                android:layout_width="76dp"
                android:layout_height="68dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_card_outline"
                android:padding="2dp">
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_detail_room"
                    app:shapeAppearanceOverlay="@style/cr8" />
            </FrameLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/thumb2"
                android:layout_width="68dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Ảnh phòng 2"
                android:scaleType="centerCrop"
                android:src="@drawable/img_room1"
                app:shapeAppearanceOverlay="@style/cr8" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/thumb3"
                android:layout_width="68dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Ảnh phòng 3"
                android:scaleType="centerCrop"
                android:src="@drawable/img_room2"
                app:shapeAppearanceOverlay="@style/cr8" />

            <FrameLayout
                android:id="@+id/thumb4"
                android:layout_width="68dp"
                android:layout_height="60dp">
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_room3"
                    app:shapeAppearanceOverlay="@style/cr8" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.6"
                    android:background="@color/color_primary_dark" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="+4"
                    android:textColor="@color/color_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Vuốt để xem ảnh · Chạm hai lần để phóng to"
            android:textColor="@color/color_text_pink"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
