<?xml version="1.0" encoding="utf-8"?>
<!-- Một tiêu chí trong "Tương thích với phòng": câu hỏi, trạng thái, câu trả lời hai bên -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CompatibilityCriterionCard">

    <TextView
        android:id="@+id/tv_criterion_title"
        style="@style/CompatibilityCriterionTitle"
        tools:text="Các thành viên trong phòng thường đi ngủ lúc mấy giờ?" />

    <TextView
        android:id="@+id/tv_criterion_status"
        style="@style/CompatibilityStatusGood"
        tools:text="✓  Phù hợp" />

    <TextView
        android:id="@+id/tv_criterion_seeker"
        style="@style/CompatibilityDetail"
        tools:text="Bạn: Trước 23:00" />

    <TextView
        android:id="@+id/tv_criterion_other"
        style="@style/CompatibilityDetail"
        tools:text="Phòng: Trước 23:00" />
</LinearLayout>
