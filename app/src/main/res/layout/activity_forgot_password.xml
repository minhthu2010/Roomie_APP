<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_forgot_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ForgotPasswordActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Top Header Navigation -->
        <RelativeLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">

            <!-- Circular Back Button -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@string/back"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/btn_back">

                <TextView
                    android:id="@+id/tv_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:text="@string/forgot_header_subtitle"
                    android:textColor="@color/primary_maroon"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_header_subtitle"
                    android:layout_alignParentStart="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/forgot_header_title"
                    android:textColor="@color/text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </RelativeLayout>

        </RelativeLayout>

        <!-- Center Badge Container (Lock icon inside light green box) -->
        <RelativeLayout
            android:id="@+id/layout_badge"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_below="@id/header_layout"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_badge_mint">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_centerInParent="true"
                android:contentDescription="@string/forgot_header_title"
                android:src="@drawable/ic_lock" />

        </RelativeLayout>

        <!-- Title & Description -->
        <TextView
            android:id="@+id/tv_forgot_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layout_badge"
            android:layout_alignParentStart="true"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/forgot_heading"
            android:textColor="@color/text_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_forgot_subtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_forgot_heading"
            android:layout_alignParentStart="true"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/forgot_subtext"
            android:textColor="@color/text_subtitle"
            android:textSize="14sp" />

        <!-- Label -->
        <TextView
            android:id="@+id/tv_label_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_forgot_subtext"
            android:layout_alignParentStart="true"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_email_or_phone"
            android:textColor="@color/text_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Input Box -->
        <RelativeLayout
            android:id="@+id/layout_input_email"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_below="@id/tv_label_email"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext_outlined"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/img_icon_email"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/label_email_or_phone"
                android:src="@drawable/ic_mail" />

            <EditText
                android:id="@+id/et_email_or_phone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@id/img_icon_email"
                android:autofillHints="emailAddress"
                android:background="@null"
                android:hint="@string/hint_email_or_phone"
                android:inputType="textEmailAddress"
                android:textColor="@color/text_title"
                android:textColorHint="@color/text_subtitle"
                android:textSize="14sp" />

        </RelativeLayout>

        <!-- Input Helper Text -->
        <TextView
            android:id="@+id/tv_input_example"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/layout_input_email"
            android:layout_alignParentStart="true"
            android:layout_marginTop="6dp"
            android:text="@string/forgot_input_example"
            android:textColor="@color/text_subtitle"
            android:textSize="12sp" />

        <!-- Info Banner Box -->
        <RelativeLayout
            android:id="@+id/layout_info_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_input_example"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_info_banner"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="@string/forgot_banner_info"
                android:textColor="@color/roomie_text_dark_green"
                android:textSize="13sp" />

        </RelativeLayout>

        <!-- Primary Action Button (Gửi mã khôi phục) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_send_code"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_below="@id/layout_info_banner"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="sans-serif-medium"
            android:text="@string/btn_send_recovery_code"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Back to Login Link -->
        <TextView
            android:id="@+id/tv_back_to_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btn_send_code"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/back_to_login"
            android:textColor="@color/primary_maroon"
            android:textSize="14sp"
            android:textStyle="bold" />

    </RelativeLayout>

</ScrollView>