<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_reset_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ResetPasswordActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Top Header Navigation -->
        <RelativeLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@string/back"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/btn_back">

                <TextView
                    android:id="@+id/tv_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:text="@string/reset_header_subtitle"
                    android:textColor="@color/primary_maroon"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_header_subtitle"
                    android:layout_alignParentStart="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/reset_header_title"
                    android:textColor="@color/text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </RelativeLayout>

        </RelativeLayout>

        <!-- Main Title & Description -->
        <TextView
            android:id="@+id/tv_reset_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/header_layout"
            android:layout_alignParentStart="true"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/reset_heading"
            android:textColor="@color/text_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_reset_subtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_reset_heading"
            android:layout_alignParentStart="true"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_subtitle"
            android:textSize="14sp" />

        <!-- New Password Field -->
        <TextView
            android:id="@+id/tv_label_new_pass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_reset_subtext"
            android:layout_alignParentStart="true"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_new_password"
            android:textColor="@color/text_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:id="@+id/layout_input_new_pass"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_below="@id/tv_label_new_pass"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext_outlined"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/img_icon_lock1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/label_new_password"
                android:src="@drawable/ic_lock" />

            <ImageView
                android:id="@+id/img_toggle_new_pass"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/desc_toggle_password"
                android:src="@drawable/ic_eye_off" />

            <EditText
                android:id="@+id/et_new_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="10dp"
                android:layout_toStartOf="@id/img_toggle_new_pass"
                android:layout_toEndOf="@id/img_icon_lock1"
                android:autofillHints="newPassword"
                android:background="@null"
                android:hint="@string/hint_new_password"
                android:inputType="textPassword"
                android:textColor="@color/text_title"
                android:textColorHint="@color/text_subtitle"
                android:textSize="14sp" />

        </RelativeLayout>

        <!-- Confirm Password Field -->
        <TextView
            android:id="@+id/tv_label_confirm_pass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/layout_input_new_pass"
            android:layout_alignParentStart="true"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_confirm_password"
            android:textColor="@color/text_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:id="@+id/layout_input_confirm_pass"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_below="@id/tv_label_confirm_pass"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext_outlined"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/img_icon_lock2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/label_confirm_password"
                android:src="@drawable/ic_lock" />

            <ImageView
                android:id="@+id/img_toggle_confirm_pass"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/desc_toggle_password"
                android:src="@drawable/ic_eye_off" />

            <EditText
                android:id="@+id/et_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="10dp"
                android:layout_toStartOf="@id/img_toggle_confirm_pass"
                android:layout_toEndOf="@id/img_icon_lock2"
                android:autofillHints="newPassword"
                android:background="@null"
                android:hint="@string/hint_confirm_new_password"
                android:inputType="textPassword"
                android:textColor="@color/text_title"
                android:textColorHint="@color/text_subtitle"
                android:textSize="14sp" />

        </RelativeLayout>

        <!-- Passwords Match Status Helper Text -->
        <TextView
            android:id="@+id/tv_match_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/layout_input_confirm_pass"
            android:layout_alignParentStart="true"
            android:layout_marginTop="6dp"
            android:text="@string/passwords_match"
            android:textColor="@color/text_subtitle"
            android:textSize="12sp" />

        <!-- Security Requirements Banner -->
        <RelativeLayout
            android:id="@+id/layout_security_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_match_status"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_info_banner"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_security_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/safe_password_title"
                android:textColor="#2D3B32"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_req1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_security_title"
                android:layout_alignParentStart="true"
                android:layout_marginTop="8dp"
                android:text="@string/req_min_chars"
                android:textColor="@color/color_text_dark_green_alt"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_req2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_req1"
                android:layout_alignParentStart="true"
                android:layout_marginTop="4dp"
                android:text="@string/req_complexity"
                android:textColor="@color/color_text_dark_green_alt"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_req3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_req2"
                android:layout_alignParentStart="true"
                android:layout_marginTop="4dp"
                android:text="@string/req_must_match"
                android:textColor="@color/color_text_dark_green_alt"
                android:textSize="13sp" />

        </RelativeLayout>

        <!-- Primary Action Button (Đặt lại mật khẩu) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_do_reset"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_below="@id/layout_security_banner"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="sans-serif-medium"
            android:text="@string/btn_reset_password"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Footer Caption -->
        <TextView
            android:id="@+id/tv_reset_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btn_do_reset"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/reset_caption"
            android:textColor="@color/text_subtitle"
            android:textSize="12sp" />

    </RelativeLayout>

</ScrollView>