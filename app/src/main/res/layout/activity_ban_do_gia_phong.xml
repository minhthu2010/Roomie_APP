<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".ui.home.BanDoGiaPhongActivity">

    <!-- Bottom Navigation Bar -->
    <include
        android:id="@+id/bottom_navigation_bar"
        layout="@layout/view_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true" />

    <!-- Selected Room Detail Overlay Card -->
    <LinearLayout
        android:id="@+id/card_selected_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_navigation_bar"
        android:background="@drawable/bg_card_rounded"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <!-- Top Drag Handle Bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_badge_sage"
            android:backgroundTint="@color/color_border" />

        <!-- Room Information Row -->
        <RelativeLayout
            android:id="@+id/layout_room_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_room_thumb"
                android:layout_width="110dp"
                android:layout_height="95dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:scaleType="centerCrop"
                android:src="@drawable/img_room1"
                app:shapeAppearanceOverlay="@style/cr8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/img_room_thumb"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_badge_match"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="@string/match_rate_94"
                        android:textColor="@color/color_white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btn_heart"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="@string/cd_favorite"
                        android:src="@drawable/ic_heart_outline" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/room_title"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="268 Lý Thường Kiệt · 0,8 km"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="3.200.000đ/tháng"
                    android:textColor="@color/color_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <!-- "Xem chi tiết" Full-width Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_room_detail"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_secondary"
            android:text="Xem chi tiết"
            android:textAllCaps="false"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- "Liên hệ Zalo" & "Gọi điện" Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_contact_zalo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_primary"
                android:drawableStart="@drawable/ic_chat"
                android:paddingHorizontal="16dp"
                android:text="Liên hệ Zalo"
                android:textAllCaps="false"
                android:textColor="@color/color_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_call_phone"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:drawableStart="@drawable/ic_phone"
                android:paddingHorizontal="16dp"
                android:text="Gọi điện"
                android:textAllCaps="false"
                android:textColor="@color/color_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Map & Overlay Container -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/card_selected_room"
        android:layout_alignParentTop="true">

        <!-- Map Mockup Graphic -->
        <ImageView
            android:id="@+id/img_map_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/btn_view_map"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_map_mockup" />

        <!-- Pins on Map -->
        <!-- Active Pin 3,2 tr -->
        <LinearLayout
            android:id="@+id/pin_3_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="110dp"
            android:layout_marginTop="110dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_selected"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="3,2 tr"
                android:textColor="@color/color_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginTop="-4dp"
                android:background="@drawable/bg_chip_selected"
                android:rotation="45" />
        </LinearLayout>

        <!-- Pin 3,8 tr -->
        <LinearLayout
            android:id="@+id/pin_3_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="50dp"
            android:layout_marginTop="140dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_unselected"
                android:elevation="2dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="3,8 tr"
                android:textColor="@color/color_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pin 4,1 tr -->
        <LinearLayout
            android:id="@+id/pin_4_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="40dp"
            android:layout_marginTop="190dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_unselected"
                android:elevation="2dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="4,1 tr"
                android:textColor="@color/color_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pin 2,9 tr -->
        <LinearLayout
            android:id="@+id/pin_2_9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="35dp"
            android:layout_marginTop="230dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_unselected"
                android:elevation="2dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="2,9 tr"
                android:textColor="@color/color_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pin 3,5 tr -->
        <LinearLayout
            android:id="@+id/pin_3_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="35dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_unselected"
                android:elevation="2dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="3,5 tr"
                android:textColor="@color/color_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Target Circle Indicator -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerInParent="true"
            android:contentDescription="@string/cd_shield_icon"
            android:src="@drawable/ic_target" />

        <!-- Floating Location Compass Button -->
        <RelativeLayout
            android:id="@+id/btn_my_location"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_circle_button"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerInParent="true"
                android:contentDescription="@string/cd_shield_icon"
                android:src="@drawable/ic_my_location" />
        </RelativeLayout>

        <!-- Top Floating Controls Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp">

            <!-- Search Bar Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Back Circle Button -->
                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_circle_button"
                    android:contentDescription="@string/cd_back"
                    android:elevation="2dp"
                    android:src="@drawable/ic_arrow_back" />

                <!-- Search Input Box -->
                <RelativeLayout
                    android:id="@+id/layout_search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_centerVertical="true"
                    android:layout_marginHorizontal="10dp"
                    android:layout_toStartOf="@id/btn_filter"
                    android:layout_toEndOf="@id/btn_back"
                    android:background="@drawable/bg_search_bar"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/icon_search"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="@string/hint_search"
                        android:src="@drawable/ic_search" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="8dp"
                        android:layout_toEndOf="@id/icon_search"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Quận 10 · gần ĐH Bách Khoa"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13sp" />
                </RelativeLayout>

                <!-- Filter Button -->
                <RelativeLayout
                    android:id="@+id/btn_filter"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_filter_btn"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_centerInParent="true"
                        android:contentDescription="@string/cd_filter"
                        android:src="@drawable/ic_filter" />
                </RelativeLayout>
            </RelativeLayout>

            <!-- Quick Filter Chips Row Floating on Map -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Chip 1: 24 phòng (Selected) -->
                    <TextView
                        android:id="@+id/chip_room_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_selected"
                        android:elevation="2dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:text="24 phòng"
                        android:textColor="@color/color_white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Chip 2: 2–4 triệu -->
                    <TextView
                        android:id="@+id/chip_price_range"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:elevation="2dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:text="2–4 triệu"
                        android:textColor="@color/color_text_primary"
                        android:textSize="12sp" />

                    <!-- Chip 3: ≥ 80% phù hợp -->
                    <TextView
                        android:id="@+id/chip_match_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:elevation="2dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:text="≥ 80% phù hợp"
                        android:textColor="@color/color_text_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>