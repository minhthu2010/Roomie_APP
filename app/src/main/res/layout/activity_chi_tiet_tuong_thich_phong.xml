<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.matching.ChiTietTuongThichPhongActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation_bar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <RelativeLayout
                    android:id="@+id/btn_back"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_circle_back"
                    android:clickable="true"
                    android:contentDescription="@string/cd_back"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_back_arrow" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/btn_back"
                    android:text="Tương thích với phòng"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:contentDescription="@string/room_detail_title"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_detail_room" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/room_detail_title"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="268 Lý Thường Kiệt, Quận 10"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_profile_hero"
                android:padding="16dp">

                <RelativeLayout
                    android:id="@+id/score_gauge"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_alignParentStart="true">

                    <View
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/bg_ring_gauge" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="94%"
                            android:textColor="@color/match_success"
                            android:textSize="30sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Với phòng"
                            android:textColor="@color/border_light"
                            android:textSize="11sp" />
                    </LinearLayout>
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/score_gauge"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_sage"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="Dữ liệu minh họa"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Thói quen người tìm với nếp sinh hoạt và quy tắc của phòng."
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/score_gauge"
                    android:layout_marginTop="12dp"
                    android:text="Điểm số và các so sánh dưới đây là minh họa, chưa phải kết quả đánh giá thực tế."
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Đây không phải mức tương thích với chủ bài đăng và không bảo đảm sống hòa hợp. Cần trao đổi trực tiếp về quy tắc trước khi ở chung."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Mức độ phù hợp theo 8 tiêu chí"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="So sánh minh họa · Không phải dữ liệu thực tế"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_outline"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView style="@style/CompatibilityCriterionTitle" android:text="Giờ ngủ và nghỉ ngơi" />
                <TextView style="@style/CompatibilityStatusDiscuss" android:text="Cần trao đổi" />
                <TextView style="@style/CompatibilityDetail" android:text="Người tìm: Ngủ trước 00:00." />
                <TextView style="@style/CompatibilityDetail" android:text="Phòng: Giờ yên tĩnh từ 23:00; cần thống nhất giờ nghỉ." />
            </LinearLayout>

            <LinearLayout style="@style/CompatibilityCriterionCard">
                <TextView style="@style/CompatibilityCriterionTitle" android:text="Vệ sinh và mức độ ngăn nắp" />
                <TextView style="@style/CompatibilityStatusGood" android:text="✓  Phù hợp" />
                <TextView style="@style/CompatibilityDetail" android:text="Người tìm: Gọn gàng, dọn dẹp hằng ngày." />
                <TextView style="@style/CompatibilityDetail" android:text="Phòng: Giữ sạch sẽ không gian chung mỗi ngày." />
            </LinearLayout>

            <LinearLayout style="@style/CompatibilityCriterionCard">
                <TextView style="@style/CompatibilityCriterionTitle" android:text="Hút thuốc" />
                <TextView style="@style/CompatibilityStatusGood" android:text="✓  Phù hợp" />
                <TextView style="@style/CompatibilityDetail" android:text="Người tìm: Không hút thuốc." />
                <TextView style="@style/CompatibilityDetail" android:text="Phòng: Không hút thuốc trong phòng." />
            </LinearLayout>

            <LinearLayout style="@style/CompatibilityCriterionCard">
                <TextView style="@style/CompatibilityCriterionTitle" android:text="Nấu ăn" />
                <TextView style="@style/CompatibilityStatusGood" android:text="✓  Phù hợp" />
                <TextView style="@style/CompatibilityDetail" android:text="Người tìm: Nấu ăn vài bữa mỗi tuần." />
                <TextView style="@style/CompatibilityDetail" android:text="Phòng: Có bếp chung để sử dụng." />
            </LinearLayout>

            <LinearLayout style="@style/CompatibilityCriterionCard">
                <TextView style="@style/CompatibilityCriterionTitle" android:text="Chia sẻ việc nhà" />
                <TextView style="@style/CompatibilityStatusGood" android:text="✓  Phù hợp" />
                <TextView style="@style/CompatibilityDetail" android:text="Người tìm: Sẵn sàng chia việc theo tuần." />
                <TextView style="@style/CompatibilityDetail" android:text="Phòng: Phân công việc nhà theo tuần." />
            </LinearLayout>

            <LinearLayout style="@style/CompatibilityCriterionCard">
                <TextView style="@style/CompatibilityCriterionTitle" android:text="Chi phí sinh hoạt" />
                <TextView style="@style/CompatibilityStatusGood" android:text="✓  Phù hợp" />
                <TextView style="@style/CompatibilityDetail" android:text="Người tìm: Muốn chia đều, ghi rõ khoản chung." />
                <TextView style="@style/CompatibilityDetail" android:text="Phòng: Chi phí chung chia đều và ghi rõ." />
            </LinearLayout>

            <LinearLayout style="@style/CompatibilityCriterionCard">
                <TextView style="@style/CompatibilityCriterionTitle" android:text="Khách đến chơi và tiếng ồn" />
                <TextView style="@style/CompatibilityStatusDiscuss" android:text="Cần trao đổi" />
                <TextView style="@style/CompatibilityDetail" android:text="Người tìm: Báo trước khi có khách đến chơi." />
                <TextView style="@style/CompatibilityDetail" android:text="Phòng: Khách báo trước; ưu tiên yên tĩnh sau 22h." />
            </LinearLayout>

            <LinearLayout style="@style/CompatibilityCriterionCard">
                <TextView style="@style/CompatibilityCriterionTitle" android:text="Cách giải quyết mâu thuẫn" />
                <TextView style="@style/CompatibilityStatusUnknown" android:text="Chưa đủ dữ liệu" />
                <TextView style="@style/CompatibilityDetail" android:text="Người tìm: Chưa có câu trả lời." />
                <TextView style="@style/CompatibilityDetail" android:text="Phòng: Chưa có quy ước xử lý bất đồng." />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_back_to_room"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_submit"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="←  Quay lại thông tin phòng"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottom_navigation_bar"
        layout="@layout/view_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true" />
</RelativeLayout>
