<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_register_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".RegisterActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Top Header Navigation -->
        <RelativeLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@string/back"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/btn_back">

                <TextView
                    android:id="@+id/tv_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:text="@string/register_step1_subtitle"
                    android:textColor="@color/primary_maroon"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_header_subtitle"
                    android:layout_alignParentStart="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/register_title"
                    android:textColor="@color/text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </RelativeLayout>

        </RelativeLayout>

        <!-- Step Indicator Progress Dots -->
        <LinearLayout
            android:id="@+id/layout_step_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/header_layout"
            android:layout_alignParentStart="true"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Step 1 Active Pill -->
            <View
                android:layout_width="22dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_button_primary" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle_button" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle_button" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle_button" />

        </LinearLayout>

        <!-- Main Title & Description -->
        <TextView
            android:id="@+id/tv_register_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layout_step_indicator"
            android:layout_alignParentStart="true"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/register_heading"
            android:textColor="@color/text_dark"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_register_subtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_register_heading"
            android:layout_alignParentStart="true"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/register_subtext"
            android:textColor="@color/text_subtitle"
            android:textSize="14sp" />

        <!-- Input 1: Full Name -->
        <TextView
            android:id="@+id/tv_label_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_register_subtext"
            android:layout_alignParentStart="true"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_full_name"
            android:textColor="@color/text_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:id="@+id/layout_input_name"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_below="@id/tv_label_name"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext_outlined"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/img_icon_person"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/label_full_name"
                android:src="@drawable/ic_person" />

            <EditText
                android:id="@+id/et_full_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@id/img_icon_person"
                android:autofillHints="name"
                android:background="@null"
                android:hint="@string/hint_full_name"
                android:inputType="textPersonName"
                android:textColor="@color/text_title"
                android:textColorHint="@color/text_subtitle"
                android:textSize="14sp" />

        </RelativeLayout>

        <!-- Input 2: Phone or Email -->
        <TextView
            android:id="@+id/tv_label_phone_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/layout_input_name"
            android:layout_alignParentStart="true"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_email_or_phone"
            android:textColor="@color/text_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:id="@+id/layout_input_phone_email"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_below="@id/tv_label_phone_email"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext_outlined"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/img_icon_phone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/label_email_or_phone"
                android:src="@drawable/ic_phone" />

            <EditText
                android:id="@+id/et_phone_or_email"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@id/img_icon_phone"
                android:autofillHints="emailAddress"
                android:background="@null"
                android:hint="@string/hint_phone_or_email"
                android:inputType="textEmailAddress"
                android:textColor="@color/text_title"
                android:textColorHint="@color/text_subtitle"
                android:textSize="14sp" />

        </RelativeLayout>

        <!-- Input 3: Password -->
        <TextView
            android:id="@+id/tv_label_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/layout_input_phone_email"
            android:layout_alignParentStart="true"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_password"
            android:textColor="@color/text_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:id="@+id/layout_input_password"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_below="@id/tv_label_password"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext_outlined"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/img_icon_lock"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/label_password"
                android:src="@drawable/ic_lock" />

            <ImageView
                android:id="@+id/img_toggle_password"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/desc_toggle_password"
                android:src="@drawable/ic_eye_off" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="10dp"
                android:layout_toStartOf="@id/img_toggle_password"
                android:layout_toEndOf="@id/img_icon_lock"
                android:autofillHints="newPassword"
                android:background="@null"
                android:hint="@string/hint_password"
                android:inputType="textPassword"
                android:textColor="@color/text_title"
                android:textColorHint="@color/text_subtitle"
                android:textSize="14sp" />

        </RelativeLayout>

        <!-- Terms Checkbox Section -->
        <RelativeLayout
            android:id="@+id/layout_terms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layout_input_password"
            android:layout_marginTop="16dp">

            <CheckBox
                android:id="@+id/cb_terms"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:buttonTint="@color/primary_maroon"
                android:checked="true" />

            <TextView
                android:id="@+id/tv_terms_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@id/cb_terms"
                android:lineSpacingExtra="2dp"
                android:text="@string/terms_agreement"
                android:textColor="@color/text_subtitle"
                android:textSize="13sp" />

        </RelativeLayout>

        <!-- Primary Action Button (Đăng ký) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_register"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_below="@id/layout_terms"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="sans-serif-medium"
            android:text="@string/btn_register"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Footer Link (Đã có tài khoản? Đăng nhập) -->
        <LinearLayout
            android:id="@+id/layout_footer_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btn_register"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/already_have_account"
                android:textColor="@color/text_subtitle"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_login_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/btn_login"
                android:textColor="@color/primary_maroon"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </RelativeLayout>

</ScrollView>