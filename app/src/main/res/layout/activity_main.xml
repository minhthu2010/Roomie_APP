<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".MainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Top Header Layout (Logo + App Name) -->
        <RelativeLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">

            <ImageView
                android:id="@+id/img_header_logo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_roomie_logo" />

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/img_header_logo"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/primary_maroon"
                android:textSize="24sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Subtitle (CHÀO MỪNG ĐẾN ROOMIE) -->
        <TextView
            android:id="@+id/tv_welcome_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/header_layout"
            android:layout_alignParentStart="true"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:text="@string/welcome_subtitle"
            android:textColor="@color/primary_maroon"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Main Title (Tìm phòng hợp ý, tìm bạn hợp gu.) -->
        <TextView
            android:id="@+id/tv_welcome_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_welcome_subtitle"
            android:layout_alignParentStart="true"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="4dp"
            android:text="@string/welcome_title"
            android:textColor="@color/text_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Description Subtext -->
        <TextView
            android:id="@+id/tv_welcome_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_welcome_title"
            android:layout_alignParentStart="true"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/welcome_desc"
            android:textColor="@color/text_subtitle"
            android:textSize="14sp" />

        <!-- Banner Card (Dark Maroon Card) -->
        <RelativeLayout
            android:id="@+id/card_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_welcome_desc"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_maroon"
            android:paddingHorizontal="20dp"
            android:paddingVertical="28dp">

            <ImageView
                android:id="@+id/img_banner_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_centerHorizontal="true"
                android:contentDescription="@string/banner_text"
                android:src="@drawable/ic_roomie_logo" />

            <TextView
                android:id="@+id/tv_banner_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/img_banner_icon"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/banner_text"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Feature Card 1 (Phòng vừa ngân sách) -->
        <RelativeLayout
            android:id="@+id/card_feature_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/card_banner"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_outlined"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_toStartOf="@id/img_icon_location">

                <TextView
                    android:id="@+id/tv_feature1_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/feature_1_title"
                    android:textColor="@color/text_title"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_feature1_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_feature1_title"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="4dp"
                    android:text="@string/feature_1_desc"
                    android:textColor="@color/text_subtitle"
                    android:textSize="12sp" />

            </RelativeLayout>

            <ImageView
                android:id="@+id/img_icon_location"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/feature_1_title"
                android:src="@drawable/ic_location" />

        </RelativeLayout>

        <!-- Feature Card 2 (Bạn cùng phòng phù hợp) -->
        <RelativeLayout
            android:id="@+id/card_feature_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/card_feature_1"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_outlined"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_toStartOf="@id/img_icon_people">

                <TextView
                    android:id="@+id/tv_feature2_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/feature_2_title"
                    android:textColor="@color/text_title"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_feature2_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_feature2_title"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="4dp"
                    android:text="@string/feature_2_desc"
                    android:textColor="@color/text_subtitle"
                    android:textSize="12sp" />

            </RelativeLayout>

            <ImageView
                android:id="@+id/img_icon_people"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/feature_2_title"
                android:src="@drawable/ic_people" />

        </RelativeLayout>

        <!-- Action Buttons & Footer Section -->
        <RelativeLayout
            android:id="@+id/layout_bottom_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/card_feature_2"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp">

            <!-- Primary Button (Đăng nhập) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_alignParentTop="true"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/btn_login"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Secondary Button (Đăng ký tài khoản) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_register"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_below="@id/btn_login"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_secondary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/btn_register"
                android:textAllCaps="false"
                android:textColor="@color/button_secondary_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Footer Caption Text -->
            <TextView
                android:id="@+id/tv_footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/btn_register"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="16dp"
                android:text="@string/footer_caption"
                android:textColor="@color/text_subtitle"
                android:textSize="12sp" />

        </RelativeLayout>

    </RelativeLayout>

</ScrollView>