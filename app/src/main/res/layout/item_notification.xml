<?xml version="1.0" encoding="utf-8"?>
<!-- Một thẻ trong màn Thông báo (layout_notifications), dựng từ API /notifications -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_rounded"
    android:padding="14dp">

    <!-- Left Icon Circle -->
    <RelativeLayout
        android:id="@+id/box_notif_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_location_icon_box">

        <ImageView
            android:id="@+id/iv_notif_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_centerInParent="true"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/text_button_secondary" />
    </RelativeLayout>

    <!-- Top Right Time & Red Unread Dot Row -->
    <LinearLayout
        android:id="@+id/box_notif_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <View
            android:id="@+id/view_unread_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_circle_fab"
            android:backgroundTint="#C53030" />
    </LinearLayout>

    <!-- Notification Content Column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@id/box_notif_time"
        android:layout_toEndOf="@id/box_notif_icon"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:textColor="@color/roomie_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_notif_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/roomie_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

</RelativeLayout>
