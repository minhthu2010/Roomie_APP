<?xml version="1.0" encoding="utf-8"?>
<!-- Thói quen sống của tôi: xem lại câu trả lời bài test theo 4 nhóm, chạm để sửa từng câu -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true"
    tools:context=".ui.quiz.LifestyleReviewActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <include
            android:id="@+id/header_bar"
            layout="@layout/include_header_bar" />

        <!-- Trạng thái bài test -->
        <LinearLayout
            android:id="@+id/card_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_maroon"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lifestyle_status_completed"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_status_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#E2EAE4"
                android:textSize="12sp"
                tools:text="Cập nhật 26/10/2026 · 8/8 câu" />

            <ProgressBar
                android:id="@+id/pb_answered"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progressDrawable="@drawable/progress_bar_on_dark" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_edit_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lifestyle_edit_hint"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Các nhóm câu hỏi được thêm từ code -->
        <LinearLayout
            android:id="@+id/layout_groups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Đang tải / lỗi / chưa làm bài -->
        <TextView
            android:id="@+id/tv_state_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/lifestyle_loading"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_retake_all"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_refresh"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/lifestyle_retake_all"
            android:textAllCaps="false"
            android:textColor="@color/text_button_secondary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
