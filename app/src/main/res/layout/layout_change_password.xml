<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_change_password"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Header Subtitle Note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/sub_change_password_header"
            android:textColor="@color/roomie_text_secondary"
            android:textSize="13sp" />

        <!-- Field 1: Mật khẩu hiện tại -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_current_password"
            android:textColor="@color/roomie_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edit_text"
            android:padding="14dp">

            <ImageView
                android:id="@+id/iv_lock1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/label_current_password"
                android:src="@drawable/ic_lock"
                app:tint="@color/roomie_text_secondary" />

            <ImageView
                android:id="@+id/iv_eye1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/label_current_password"
                android:src="@drawable/ic_eye_off"
                app:tint="@color/roomie_text_secondary" />

            <EditText
                android:id="@+id/et_current_pass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/iv_lock1"
                android:layout_toStartOf="@id/iv_eye1"
                android:autofillHints="password"
                android:background="@null"
                android:hint="@string/label_current_password"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:text="@string/sample_dots_pass"
                android:textColor="@color/roomie_text_primary"
                android:textSize="15sp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/btn_forgot_pass_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/link_forgot_current_pass"
            android:textColor="@color/maroon_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Field 2: Mật khẩu mới -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_new_password"
            android:textColor="@color/roomie_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_edit_text"
            android:padding="14dp">

            <ImageView
                android:id="@+id/iv_lock2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/label_new_password"
                android:src="@drawable/ic_lock"
                app:tint="@color/roomie_text_secondary" />

            <ImageView
                android:id="@+id/iv_eye2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/label_new_password"
                android:src="@drawable/ic_eye_off"
                app:tint="@color/roomie_text_secondary" />

            <EditText
                android:id="@+id/et_new_pass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/iv_lock2"
                android:layout_toStartOf="@id/iv_eye2"
                android:autofillHints="newPassword"
                android:background="@null"
                android:hint="@string/label_new_password"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:text="@string/sample_dots_new_pass"
                android:textColor="@color/roomie_text_primary"
                android:textSize="15sp" />
        </RelativeLayout>

        <!-- Field 3: Xác nhận mật khẩu mới -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_confirm_new_pass"
            android:textColor="@color/roomie_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_edit_text"
            android:padding="14dp">

            <ImageView
                android:id="@+id/iv_lock3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/label_confirm_new_pass"
                android:src="@drawable/ic_lock"
                app:tint="@color/roomie_text_secondary" />

            <ImageView
                android:id="@+id/iv_eye3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/label_confirm_new_pass"
                android:src="@drawable/ic_eye_off"
                app:tint="@color/roomie_text_secondary" />

            <EditText
                android:id="@+id/et_confirm_pass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/iv_lock3"
                android:layout_toStartOf="@id/iv_eye3"
                android:autofillHints="newPassword"
                android:background="@null"
                android:hint="@string/label_confirm_new_pass"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:text="@string/sample_dots_new_pass"
                android:textColor="@color/roomie_text_primary"
                android:textSize="15sp" />
        </RelativeLayout>

        <!-- Security Criteria Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/title_secure_pass_criteria"
                android:textColor="@color/roomie_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/criteria_pass_1"
                android:textColor="@color/text_button_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/criteria_pass_2"
                android:textColor="@color/text_button_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/criteria_pass_3"
                android:textColor="@color/text_button_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Disclaimer Note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/disclaimer_pass_security"
            android:textColor="@color/roomie_text_secondary"
            android:textSize="12sp" />

        <!-- Action Buttons Row using LinearLayout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_cancel_change_pass"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/btn_cancel"
                android:textAllCaps="false"
                android:textColor="@color/text_button_secondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save_password"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_button_primary"
                android:text="@string/btn_save_password"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
