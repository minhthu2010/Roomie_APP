<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_login_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".LoginActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Top Header Layout (Logo + App Name) -->
        <RelativeLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">

            <ImageView
                android:id="@+id/img_header_logo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_roomie_logo" />

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/img_header_logo"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/primary_maroon"
                android:textSize="24sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Subtitle (CHÀO MỪNG TRỜ LẠI) -->
        <TextView
            android:id="@+id/tv_login_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/header_layout"
            android:layout_alignParentStart="true"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:text="@string/login_welcome_back"
            android:textColor="@color/primary_maroon"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Main Title (Đăng nhập) -->
        <TextView
            android:id="@+id/tv_login_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_login_subtitle"
            android:layout_alignParentStart="true"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/login_title"
            android:textColor="@color/text_dark"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Description Subtext -->
        <TextView
            android:id="@+id/tv_login_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_login_title"
            android:layout_alignParentStart="true"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/login_desc"
            android:textColor="@color/text_subtitle"
            android:textSize="14sp" />

        <!-- Email / Phone Input Label -->
        <TextView
            android:id="@+id/tv_label_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_login_desc"
            android:layout_alignParentStart="true"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_email_or_phone"
            android:textColor="@color/text_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Email Input Field -->
        <RelativeLayout
            android:id="@+id/layout_input_email"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_below="@id/tv_label_email"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext_outlined"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/img_icon_email"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/label_email_or_phone"
                android:src="@drawable/ic_mail" />

            <EditText
                android:id="@+id/et_email_or_phone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@id/img_icon_email"
                android:autofillHints="emailAddress"
                android:background="@null"
                android:hint="@string/hint_email_or_phone"
                android:inputType="textEmailAddress"
                android:textColor="@color/text_title"
                android:textColorHint="@color/text_subtitle"
                android:textSize="14sp" />

        </RelativeLayout>

        <!-- Password Input Label -->
        <TextView
            android:id="@+id/tv_label_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/layout_input_email"
            android:layout_alignParentStart="true"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_password"
            android:textColor="@color/text_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Password Input Field -->
        <RelativeLayout
            android:id="@+id/layout_input_password"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_below="@id/tv_label_password"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext_outlined"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/img_icon_lock"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/label_password"
                android:src="@drawable/ic_lock" />

            <ImageView
                android:id="@+id/img_toggle_password"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/desc_toggle_password"
                android:src="@drawable/ic_eye_off" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="10dp"
                android:layout_toStartOf="@id/img_toggle_password"
                android:layout_toEndOf="@id/img_icon_lock"
                android:autofillHints="password"
                android:background="@null"
                android:hint="@string/hint_password"
                android:inputType="textPassword"
                android:textColor="@color/text_title"
                android:textColorHint="@color/text_subtitle"
                android:textSize="14sp" />

        </RelativeLayout>

        <!-- Forgot Password Link -->
        <TextView
            android:id="@+id/tv_forgot_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/layout_input_password"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/forgot_password"
            android:textColor="@color/primary_maroon"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Login Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_do_login"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_below="@id/tv_forgot_password"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="sans-serif-medium"
            android:text="@string/btn_login"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Divider with "HOẶC" -->
        <RelativeLayout
            android:id="@+id/layout_divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/btn_do_login"
            android:layout_marginTop="24dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_toStartOf="@id/tv_divider_text"
                android:background="@color/card_border" />

            <TextView
                android:id="@+id/tv_divider_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:letterSpacing="0.05"
                android:text="@string/divider_or"
                android:textColor="@color/text_subtitle"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/tv_divider_text"
                android:background="@color/card_border" />

        </RelativeLayout>

        <!-- Google Login Button -->
        <RelativeLayout
            android:id="@+id/btn_google_login"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_below="@id/layout_divider"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_google"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/btn_google_login"
                    android:src="@drawable/ic_google" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/btn_google_login"
                    android:textColor="@color/text_title"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </RelativeLayout>

        <!-- Bottom Footer Text (Chưa có tài khoản? Đăng ký ngay) -->
        <LinearLayout
            android:id="@+id/layout_footer_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btn_google_login"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_account_prompt"
                android:textColor="@color/text_subtitle"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_register_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/register_now"
                android:textColor="@color/primary_maroon"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </RelativeLayout>

</ScrollView>