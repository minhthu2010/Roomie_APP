<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_edit_profile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Avatar Upload Row using RelativeLayout -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_edit_avatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/btn_change_avatar"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_profile"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="14dp"
                android:layout_toEndOf="@id/iv_edit_avatar"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_edit_change_avatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/btn_change_avatar"
                    android:textColor="@color/maroon_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/sub_change_avatar"
                    android:textColor="@color/roomie_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Field 1: Tên hiển thị -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_display_name"
            android:textColor="@color/roomie_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_edit_display_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:autofillHints="name"
            android:background="@drawable/bg_edit_text"
            android:hint="@string/hint_display_name"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:padding="14dp"
            android:textColor="@color/roomie_text_primary"
            android:textSize="15sp" />

        <!-- Field 2: Nghề nghiệp -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_occupation"
            android:textColor="@color/roomie_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_edit_text"
            android:padding="14dp">

            <ImageView
                android:id="@+id/iv_dropdown_occ"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/label_occupation"
                android:src="@drawable/ic_arrow_down" />

            <EditText
                android:id="@+id/et_edit_occupation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/iv_dropdown_occ"
                android:autofillHints="none"
                android:background="@null"
                android:hint="@string/hint_choose_occupation"
                android:importantForAutofill="no"
                android:inputType="text"
                android:textColor="@color/roomie_text_primary"
                android:textSize="15sp" />
        </RelativeLayout>

        <!-- Giới tính & Năm sinh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/label_gender"
                android:textColor="@color/roomie_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edit_text"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/iv_gender_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/label_gender"
                    android:src="@drawable/ic_arrow_down" />

                <TextView
                    android:id="@+id/tv_edit_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/iv_gender_icon"
                    android:hint="@string/hint_choose_gender"
                    android:textColor="@color/roomie_text_primary"
                    android:textColorHint="@color/roomie_text_secondary"
                    android:textSize="15sp" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/label_birth_year"
                android:textColor="@color/roomie_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edit_text"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/iv_birth_year_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/label_birth_year"
                    android:src="@drawable/ic_arrow_down" />

                <TextView
                    android:id="@+id/tv_edit_birth_year"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/iv_birth_year_icon"
                    android:hint="@string/hint_choose_birth_year"
                    android:textColor="@color/roomie_text_primary"
                    android:textColorHint="@color/roomie_text_secondary"
                    android:textSize="15sp" />
            </RelativeLayout>
        </LinearLayout>
        </LinearLayout>

        <!-- Khu vực muốn tìm phòng (chọn trước để gợi ý trường đúng tỉnh) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_living_area"
            android:textColor="@color/roomie_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_edit_text"
            android:padding="14dp">

            <ImageView
                android:id="@+id/iv_area_loc_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/label_living_area"
                android:src="@drawable/ic_location_on"
                app:tint="@color/roomie_text_secondary" />

            <EditText
                android:id="@+id/et_edit_living_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/iv_area_loc_icon"
                android:autofillHints="postalAddress"
                android:background="@null"
                android:hint="@string/hint_choose_area"
                android:importantForAutofill="no"
                android:inputType="textPostalAddress"
                android:textColor="@color/roomie_text_primary"
                android:textSize="15sp" />
        </RelativeLayout>

        <!-- Field 3: Trường học / nơi làm việc -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_school_workplace"
            android:textColor="@color/roomie_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_edit_text"
            android:padding="14dp">

            <ImageView
                android:id="@+id/iv_school_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/label_school_workplace"
                android:src="@drawable/ic_school"
                app:tint="@color/roomie_text_secondary" />

            <EditText
                android:id="@+id/et_edit_school"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/iv_school_icon"
                android:autofillHints="none"
                android:background="@null"
                android:hint="@string/hint_choose_school"
                android:importantForAutofill="no"
                android:inputType="text"
                android:textColor="@color/roomie_text_primary"
                android:textSize="15sp" />
        </RelativeLayout>

        <!-- Field 4: Giới thiệu bản thân -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_about_me"
            android:textColor="@color/roomie_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_edit_about_me"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:autofillHints="none"
            android:background="@drawable/bg_edit_text"
            android:gravity="top|start"
            android:hint="@string/hint_bio"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:lineSpacingExtra="3dp"
            android:minLines="3"
            android:padding="14dp"
            android:textColor="@color/roomie_text_primary"
            android:textSize="14sp" />

        <!-- Ngân sách & Ngày dọn vào -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/label_budget"
                android:textColor="@color/roomie_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/et_edit_budget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="none"
                android:background="@drawable/bg_edit_text"
                android:hint="@string/hint_budget"
                android:importantForAutofill="no"
                android:inputType="text"
                android:padding="14dp"
                android:textColor="@color/roomie_text_primary"
                android:textColorHint="@color/roomie_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/label_move_in_date"
                android:textColor="@color/roomie_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edit_text"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/iv_move_in_date_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/label_move_in_date"
                    android:src="@drawable/ic_calendar" />

                <TextView
                    android:id="@+id/tv_edit_move_in_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/iv_move_in_date_icon"
                    android:hint="@string/hint_move_in_date"
                    android:textColor="@color/roomie_text_primary"
                    android:textColorHint="@color/roomie_text_secondary"
                    android:textSize="15sp" />
            </RelativeLayout>
        </LinearLayout>
        </LinearLayout>

        <!-- Bạn đang muốn tìm gì -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_looking_for"
            android:textColor="@color/roomie_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_edit_pill_find_room"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_pill_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/opt_find_room"
                android:textColor="@color/text_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_edit_pill_find_roommate"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/opt_find_roommate"
                android:textColor="@color/text_title"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Disclaimer Note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/disclaimer_edit_profile"
            android:textColor="@color/roomie_text_secondary"
            android:textSize="12sp" />

        <!-- Action Buttons Row using LinearLayout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_cancel_edit_profile"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/btn_cancel"
                android:textAllCaps="false"
                android:textColor="@color/text_button_secondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save_profile_changes"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_button_primary"
                android:text="@string/btn_save_changes"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
