<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tv_title_basic_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thông tin cơ bản"
            android:textColor="@color/color_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Tiêu đề bài đăng -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Tiêu đề bài đăng"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_post_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_outline"
            android:hint="Nổi bật ưu điểm chính, tối đa 80 ký tự"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:text="Phòng sáng ban công gần ĐH Bách Khoa"
            android:textColor="@color/color_text_primary"
            android:textColorHint="@color/color_text_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Nổi bật ưu điểm chính, tối đa 80 ký tự"
            android:textColor="@color/color_text_muted"
            android:textSize="12sp" />

        <!-- Mô tả -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mô tả"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_post_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_outline"
            android:gravity="top|start"
            android:minHeight="120dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:text="Phòng thoáng, nhiều ánh sáng tự nhiên, cách trường 7 phút đi bộ. Khu vực an ninh và yên tĩnh..."
            android:textColor="@color/color_text_primary"
            android:textColorHint="@color/color_text_muted"
            android:textSize="14sp" />

        <!-- Số bạn cùng phòng cần tìm -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Số bạn cùng phòng cần tìm"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_roommate_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_chip_highlight"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp"
                android:text="1 người"
                android:textColor="@color/color_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_roommate_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_chip_outline"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp"
                android:text="2 người"
                android:textColor="@color/color_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_roommate_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_outline"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp"
                android:text="3 người+"
                android:textColor="@color/color_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Ngày chuyển vào -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ngày chuyển vào"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layout_move_in_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_outline"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/label_move_in_date"
                android:src="@drawable/ic_calendar" />

            <EditText
                android:id="@+id/et_move_in_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:focusable="false"
                android:text="15/10/2026"
                android:textColor="@color/color_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>