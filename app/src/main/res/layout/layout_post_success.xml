<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_post_success"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <!-- Success Graphic Ring using RelativeLayout -->
        <RelativeLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp">

            <View
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/bg_circle_success_outer" />

            <RelativeLayout
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_circle_success_inner">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/title_post_success"
                    android:src="@drawable/ic_check_maroon" />
            </RelativeLayout>
        </RelativeLayout>

        <!-- Main Title Headline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/title_post_success"
            android:textColor="@color/roomie_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- "Bài đăng của bạn" Section Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/label_your_post"
                android:textColor="@color/roomie_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Post Card Container using RelativeLayout -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:padding="12dp">

                <!-- Room Thumbnail Image -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_success_card_thumb"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/card_post_title_sample"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_sample_room"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                <!-- Post Details Column using LinearLayout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="14dp"
                    android:layout_toEndOf="@id/iv_success_card_thumb"
                    android:orientation="vertical">

                    <!-- Status Pill Badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_status_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/status_searching"
                        android:textColor="@color/text_button_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Post Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/card_post_title_sample"
                        android:textColor="@color/roomie_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Price -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/post_price_sample"
                        android:textColor="@color/maroon_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Location Row using RelativeLayout -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/iv_success_loc_icon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@string/card_location_sample"
                            android:src="@drawable/ic_location_on"
                            app:tint="@color/roomie_text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@id/iv_success_loc_icon"
                            android:text="@string/card_location_sample"
                            android:textColor="@color/roomie_text_secondary"
                            android:textSize="12sp" />
                    </RelativeLayout>

                </LinearLayout>

            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
