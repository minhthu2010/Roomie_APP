<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_send_feedback"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Header Subtitle Note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/sub_send_feedback_header"
            android:textColor="@color/roomie_text_secondary"
            android:textSize="13sp" />

        <!-- Section 1: Loại phản hồi -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_feedback_type"
            android:textColor="@color/roomie_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Feedback Type Chips Row using LinearLayout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_maroon"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/chip_suggestion"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_outline"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/chip_bug_report"
                android:textColor="@color/roomie_text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_outline"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/chip_need_help"
                android:textColor="@color/roomie_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Section 2: Tiêu đề -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_subject"
            android:textColor="@color/roomie_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_feedback_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:autofillHints="none"
            android:background="@drawable/bg_edit_text"
            android:hint="@string/label_subject"
            android:importantForAutofill="no"
            android:inputType="text"
            android:padding="14dp"
            android:text="@string/sample_subject_feedback"
            android:textColor="@color/roomie_text_primary"
            android:textSize="15sp" />

        <!-- Section 3: Nội dung phản hồi -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_feedback_content"
            android:textColor="@color/roomie_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_feedback_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="none"
            android:background="@drawable/bg_edit_text"
            android:gravity="top|start"
            android:hint="@string/label_feedback_content"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:lineSpacingExtra="3dp"
            android:minLines="3"
            android:padding="14dp"
            android:text="@string/sample_content_feedback"
            android:textColor="@color/roomie_text_primary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="@string/char_counter_sample"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- Section 4: Ảnh minh họa (không bắt buộc) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_attach_photo"
            android:textColor="@color/roomie_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_add_photo_dashed"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/label_attach_photo"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/text_button_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/text_add_photo_max3"
                    android:textColor="@color/text_button_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Section 5: Email nhận phản hồi -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_email_feedback"
            android:textColor="@color/roomie_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_edit_text"
            android:padding="14dp">

            <ImageView
                android:id="@+id/iv_fb_mail_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/label_email_feedback"
                android:src="@drawable/ic_feedback"
                app:tint="@color/roomie_text_secondary" />

            <EditText
                android:id="@+id/et_feedback_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/iv_fb_mail_icon"
                android:autofillHints="emailAddress"
                android:background="@null"
                android:hint="@string/label_email_feedback"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:text="@string/sample_email"
                android:textColor="@color/roomie_text_primary"
                android:textSize="15sp" />
        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/disclaimer_feedback_email"
            android:textColor="@color/roomie_text_secondary"
            android:textSize="12sp" />

        <!-- Action Buttons Row using LinearLayout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_cancel_feedback"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/btn_cancel"
                android:textAllCaps="false"
                android:textColor="@color/text_button_secondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_submit_feedback_final"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_button_primary"
                android:text="@string/btn_submit_feedback"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
