<?xml version="1.0" encoding="utf-8"?>
<!-- Một nhóm trong "Mức độ phù hợp theo nhóm": tên + % + thanh -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_group_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:textColor="@color/primary_maroon"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="98%" />

        <TextView
            android:id="@+id/tv_group_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/tv_group_percent"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            tools:text="Sạch sẽ &amp; việc nhà" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_filter_btn"
        android:orientation="horizontal">

        <View
            android:id="@+id/view_bar_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="50"
            android:background="@drawable/bg_badge_match" />

        <View
            android:id="@+id/view_bar_rest"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="50" />
    </LinearLayout>
</LinearLayout>
