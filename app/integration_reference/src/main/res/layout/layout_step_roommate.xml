<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_step_roommate"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- Main Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/main_heading"
            android:textColor="@color/roomie_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Section 1: Ưu tiên bạn cùng phòng -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/section_priority"
            android:textColor="@color/roomie_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_priority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_female"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/chip_female"
                android:textColor="@color/chip_text_selector"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_background_selector"
                app:chipCornerRadius="20dp"
                app:chipStrokeColor="@color/chip_stroke_selector"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_male"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/chip_male"
                android:textColor="@color/chip_text_selector"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_background_selector"
                app:chipCornerRadius="20dp"
                app:chipStrokeColor="@color/chip_stroke_selector"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_no_pref"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/chip_no_pref"
                android:textColor="@color/chip_text_selector"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_background_selector"
                app:chipCornerRadius="20dp"
                app:chipStrokeColor="@color/chip_stroke_selector"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_student"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/chip_student"
                android:textColor="@color/chip_text_selector"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_background_selector"
                app:chipCornerRadius="20dp"
                app:chipStrokeColor="@color/chip_stroke_selector"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_worker"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/chip_worker"
                android:textColor="@color/chip_text_selector"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_background_selector"
                app:chipCornerRadius="20dp"
                app:chipStrokeColor="@color/chip_stroke_selector"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_no_smoking"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/chip_no_smoking"
                android:textColor="@color/chip_text_selector"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_background_selector"
                app:chipCornerRadius="20dp"
                app:chipStrokeColor="@color/chip_stroke_selector"
                app:chipStrokeWidth="1dp" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Section 2: Mong muốn khi sống chung -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/section_expectations"
            android:textColor="@color/roomie_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_expectations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:autofillHints="none"
            android:background="@drawable/bg_edit_text"
            android:gravity="top|start"
            android:hint="@string/section_expectations"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:lineSpacingExtra="3dp"
            android:minLines="3"
            android:padding="16dp"
            android:text="@string/hint_expectations"
            android:textColor="@color/roomie_text_primary"
            android:textSize="14sp" />

        <!-- Section 3: Số điện thoại liên hệ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/section_phone"
            android:textColor="@color/roomie_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Phone Card using RelativeLayout -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_card_rounded"
            android:padding="16dp">

            <ImageView
                android:id="@+id/iv_phone_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/section_phone"
                android:src="@drawable/ic_phone"
                app:tint="@color/roomie_text_secondary" />

            <EditText
                android:id="@+id/et_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/iv_phone_icon"
                android:autofillHints="phone"
                android:background="@null"
                android:hint="@string/section_phone"
                android:inputType="phone"
                android:text="@string/sample_phone"
                android:textColor="@color/roomie_text_primary"
                android:textSize="15sp" />
        </RelativeLayout>

        <!-- Section 4: Switches using RelativeLayout -->
        <!-- Zalo Switch Card -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_rounded"
            android:padding="16dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_zalo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:checked="true"
                app:thumbTint="@color/switch_thumb_selector"
                app:trackTint="@color/switch_track_selector" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_toStartOf="@id/switch_zalo"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_allow_zalo"
                    android:textColor="@color/roomie_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/subtitle_allow_zalo"
                    android:textColor="@color/roomie_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Call Switch Card -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_rounded"
            android:padding="16dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_call"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:checked="true"
                app:thumbTint="@color/switch_thumb_selector"
                app:trackTint="@color/switch_track_selector" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_toStartOf="@id/switch_call"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_allow_call"
                    android:textColor="@color/roomie_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/subtitle_allow_call"
                    android:textColor="@color/roomie_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Disclaimer Note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/disclaimer_contact"
            android:textColor="@color/roomie_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
